# DOMAIN comes from the environment (the compose file passes it in). With a real domain Caddy asks Let's Encrypt
# for a certificate and renews it; for local tests set DOMAIN=localhost and Caddy makes its own.
{$DOMAIN} {
	encode zstd gzip

	# Body size limits: a body over the limit gets a 413 before the backend reads it (the same limit is checked again
	# by the backend's JSON parser). Only a Tank Photo upload (POST /api/tanks/<id>/photos) may be large: the
	# backend accepts 10 MB plus form fields. "MB" here is 1,000,000 bytes.
	@photoUpload {
		method POST
		path_regexp ^/api/tanks/[^/]+/photos/?$
	}
	handle @photoUpload {
		request_body {
			max_size 12MB
		}
		reverse_proxy backend:8080
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	# Everything else is the single-page app: unknown paths fall back to index.html so React Router can handle them.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# www.<domain> sends visitors to the main address (needs its own DNS record, see the runbook).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
